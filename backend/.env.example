CMX_ENVIRONMENT=development
CMX_AUTH_MODE=development

# Required when CMX_AUTH_MODE=cloudflare
CMX_CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CMX_CLOUDFLARE_ACCESS_AUDIENCE=replace-with-access-application-aud

CMX_ALLOWED_HOSTS_CSV=localhost,127.0.0.1,testserver,db-staging.cmxchat.com,db.cmxchat.com

# Direct local development can use SQLite. Docker Compose overrides this with PostgreSQL.
CMX_DATABASE_URL=sqlite+pysqlite:///./cmx-dev.db
CMX_DATABASE_AUTO_CREATE=true

POSTGRES_USER=cmx
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=cmx

CMX_DNS_TIMEOUT_SECONDS=8
CMX_DNS_CACHE_TTL_SECONDS=60
CMX_API_RATE_LIMIT_PER_MINUTE=60
CMX_TRUST_PROXY_HEADERS=true

# Used only by the optional cloudflared Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
